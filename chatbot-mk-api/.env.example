NODE_ENV=development
PORT=3001

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

JWT_SECRET=your-jwt-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

OPENAI_API_KEY=sk-your-openai-api-key

CORS_ORIGIN=http://localhost:8080

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Meta / Facebook Integration
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=chatbotmk-verify-token
META_API_VERSION=v19.0
META_LOGIN_CONFIG_ID=3574087546065669

# Encryption key for storing access tokens at rest (32+ chars)
DATABASE_ENCRYPTION_KEY=change-this-to-a-random-32-char-string

# Public URL of this API server (used for OAuth redirect)
APP_URL=http://localhost:3001
